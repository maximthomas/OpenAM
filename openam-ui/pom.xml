<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openidentityplatform.openam</groupId>
        <artifactId>openam</artifactId>
        <version>16.2.0-SNAPSHOT</version>
    </parent>
	<properties>
		<node.install.directory>${project.basedir}</node.install.directory>
		<jquery.version>3.7.1</jquery.version>
		<bootstrap.version>3.3.5</bootstrap.version>
	</properties>

    <artifactId>openam-ui</artifactId>
    <name>OpenAM UI Parent</name>
    <packaging>pom</packaging>
    <modules>
        <module>openam-ui-ria</module>
        <module>openam-ui-api</module>
		<module>openam-ui-js-sdk</module>
    </modules>
    <build>
		<!--
		    TASK 4.8 DELETED maven-external-dependency-plugin FROM THIS POM.

		    It fetched artifacts from CDNs and installed them into ~/.m2 under
		    org.openidentityplatform.commons.ui.libs, published to NO repository, so a
		    developer's ~/.m2 was the only copy - and several downloadUrls pointed at
		    unpinned `master` refs or dead vanity domains, so the same coordinate could
		    yield different bytes on a re-fetch. Task 4.7 cut it from 60 artifactItems to
		    1; 4.8 took the last one, the CodeMirror zip, to npm codemirror@4.10.0 - all
		    six of its files byte-identical to what shipped. Every runtime library AM ships
		    is now a declared npm dependency of openam-ui-ria, pinned in its
		    package-lock.json and visible to `npm audit`, as ui-build-and-packaging's
		    "Runtime libraries are managed package dependencies" requires. See
		    openam-ui-ria/NOTES-libs-retire.md.

		    THE clean-external WARNING IS RETIRED WITH IT. `mvn clean` on this module and
		    `mvn ... -am` from the OpenAM root no longer destroy anything unrecoverable:
		    the goal that did went with the plugin, and no unpublished artifact is left for
		    it to delete. Whatever commons.ui.libs artifacts a developer still has in ~/.m2
		    are now inert - nothing in this build resolves them. OpenAM/pom.xml keeps its
		    own inherited=false copy of this plugin, but it manages only cddl-license, jato
		    and cc, which restore from a live URL and from extlib/ in the repo.

		    The sibling commons/ui checkout keeps its own copy of this plugin and is
		    unaffected.
		-->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>1.15.4</version>
					<configuration>
						<installDirectory>${node.install.directory}</installDirectory>
					</configuration>
					<executions>
						<execution>
							<id>install-node-and-npm</id>
							<goals>
								<goal>install-node-and-npm</goal>
							</goals>
							<phase>initialize</phase>
							<configuration>
								<nodeVersion>v22.21.1</nodeVersion>
								<npmVersion>11.6.2</npmVersion>
							</configuration>
						</execution>
						<execution>
							<id>npm-install</id>
							<goals>
								<goal>npm</goal>
							</goals>
							<phase>initialize</phase>
							<configuration>
								<arguments>install</arguments>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
    </build>

</project>
