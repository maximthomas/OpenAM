{
    /*
     * The Karma-era ../.eslintrc.json this used to sit under is gone -- task 9.2 deleted it with
     * the src/test/js tree it described -- so the settings it carried that this tree still needs
     * are restated here rather than inherited.
     *
     * env.mocha stays off. Every file here imports `describe`, `it` and `expect` from "vitest"
     * explicitly, which is what makes a forgotten import a real no-undef error rather than a
     * silent pass. The old `globals: { expect }` entry is simply gone with its file; it does not
     * need an override any more, which is the resolution the 9.1 note here predicted.
     *
     * no-unused-expressions is off because chai property assertions -- `.to.be.empty`,
     * `.to.not.be.called`, `.to.be.true` -- ARE bare expressions. It used to cascade from
     * ../.eslintrc.json; deleting that file turned 27 assertions in the 9.1 ports into errors,
     * which is how this came to be written down.
     *
     * ecmaVersion is raised from the root's 6 because the ports use async beforeEach hooks to
     * await a dynamic import -- that is how a case gets a fresh module instance now that Squire's
     * per-injector RequireJS context is gone. 2018 is the ceiling: this module pins ESLint 3.8.1,
     * whose espree 3.5.4 parses async functions but NOT dynamic `import()`. So the five files
     * that call `await import(...)` still fail to PARSE under `npm run lint` and are reported as
     * errors there. They run correctly; the linter is simply nine years older than the syntax.
     * Nothing here can fix that -- only a newer ESLint can.
     */
    "parserOptions": {
        "ecmaVersion": 2018
    },
    "env": {
        "mocha": false
    },
    "rules": {
        "no-unused-expressions": 0
    }
}
