{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/main/vue/*"]
    },
    "baseUrl": ".",
    "types": ["vitest/globals", "vite/client"]
  },
  "include": [
    "src/main/vue/**/*.ts",
    "src/main/vue/**/*.d.ts",
    "src/main/vue/**/*.vue",
    "src/test/vue/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "target"]
}
