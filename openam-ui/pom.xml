<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.openidentityplatform.openam</groupId>
        <artifactId>openam</artifactId>
        <version>16.2.0-SNAPSHOT</version>
    </parent>
	<properties>
		<node.install.directory>${project.basedir}</node.install.directory>
		<jquery.version>3.7.1</jquery.version>
		<bootstrap.version>3.3.5</bootstrap.version>
	</properties>

    <artifactId>openam-ui</artifactId>
    <name>OpenAM UI Parent</name>
    <packaging>pom</packaging>
    <modules>
        <module>openam-ui-ria</module>
        <module>openam-ui-api</module>
		<module>openam-ui-js-sdk</module>
    </modules>
    <build>
    		<plugins>
    			<plugin>
				<groupId>org.openidentityplatform.commons</groupId>
				<artifactId>maven-external-dependency-plugin</artifactId>
				<!--
				    TASK 4.7 CUT THIS PLUGIN FROM 60 artifactItems TO 1.

				    It fetches artifacts from CDNs and installs them into ~/.m2 under
				    org.openidentityplatform.commons.ui.libs. They are published to NO
				    repository, so a developer's ~/.m2 is the only copy, and several of the
				    downloadUrls above pointed at unpinned `master` refs or dead vanity domains -
				    the same coordinate could yield different bytes on a re-fetch, which is
				    exactly the drift task 3.7 caught in form2js. All 59 runtime and test
				    artifacts are now declared npm dependencies of openam-ui-ria, pinned in its
				    package-lock.json and visible to `npm audit`, as
				    ui-build-and-packaging's "Runtime libraries are managed package
				    dependencies" requires. See openam-ui-ria/NOTES-libs-retire.md.

				    ONE IS LEFT: the CodeMirror zip, which TASK 4.8 owns. WHEN 4.8 REPLACES IT,
				    DELETE THIS WHOLE PLUGIN - that is what finally removes the clean-external
				    execution below, and with it the single most expensive mistake available in
				    this build. Until then the warning stands: `mvn clean` on this module, or
				    `mvn ... -am` from the OpenAM root, runs clean-external and DELETES the
				    artifact from ~/.m2 with no way back but a CDN round trip. Use
				    `rm -rf <module>/target`.

				    Removing the other 59 entries does NOT delete anything already in ~/.m2 -
				    clean-external only deletes what is listed here, so this change strictly
				    shrinks that blast radius. The sibling commons/ui checkout keeps its own copy
				    of this plugin and is unaffected.
				-->
				<inherited>false</inherited>
				<configuration>
					<stagingDirectory>
						${project.build.directory}/dependencies/
                    </stagingDirectory>
					<createChecksum>false</createChecksum>
					<skipChecksumVerification>true</skipChecksumVerification>
									<force>false</force>
					<artifactItems>
				            <artifactItem>
				              <groupId>org.openidentityplatform.commons.ui.libs</groupId>
				              <artifactId>CodeMirror</artifactId>
				              <version>4.10</version>
				              <packaging>zip</packaging>
				              <downloadUrl>https://github.com/codemirror/{artifactId}5/archive/{version}.0.{packaging}</downloadUrl>
				            </artifactItem>
					</artifactItems>
				</configuration>
				<executions>
					<execution>
						<id>clean-external-dependencies</id>
						<phase>clean</phase>
						<goals>
							<goal>clean-external</goal>
						</goals>
					</execution>
					<execution>
						<id>resolve-install-external-dependencies</id>
						<phase>process-resources</phase>
						<goals>
							<goal>resolve-external</goal>
							<goal>install-external</goal>
						</goals>
					</execution>
<!-- 					<execution> -->
<!-- 						<id>deploy-external-dependencies</id> -->
<!-- 						<phase>deploy</phase> -->
<!-- 						<goals> -->
<!-- 							<goal>deploy-external</goal> -->
<!-- 						</goals> -->
<!-- 					</execution> -->
				</executions>
			</plugin>
    		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>1.15.4</version>
					<configuration>
						<installDirectory>${node.install.directory}</installDirectory>
					</configuration>
					<executions>
						<execution>
							<id>install-node-and-npm</id>
							<goals>
								<goal>install-node-and-npm</goal>
							</goals>
							<phase>initialize</phase>
							<configuration>
								<nodeVersion>v22.21.1</nodeVersion>
								<npmVersion>11.6.2</npmVersion>
							</configuration>
						</execution>
						<execution>
							<id>npm-install</id>
							<goals>
								<goal>npm</goal>
							</goals>
							<phase>initialize</phase>
							<configuration>
								<arguments>install</arguments>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
    </build>

</project>
