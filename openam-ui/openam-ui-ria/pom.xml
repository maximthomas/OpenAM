            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>org.openidentityplatform.commons.ui.libs</groupId>
            <artifactId>bootstrap-clockpicker</artifactId>
            <version>0.0.7</version>
            <classifier>min</classifier>
