{
  "name": "openam-ui-ria",
  "version": "14.0.0",
  "private": true,
  "scripts": {
    "clean:deps": "rimraf rimraf npm-shrinkwrap.json && rimraf node_modules",
    "clean:jsdoc": "rimraf jsdoc",
    "prejsdoc": "npm run clean:jsdoc -s",
    "jsdoc": "jsdoc --configure config/jsdoc/configuration.json",
    "start": "grunt",
    "dev": "vite",
    "build:production": "vite build",
    "build:grunt": "cross-env NODE_ENV=production grunt prod --verbose",
    "lint": "eslint --ext .js,.jsm,.jsx --ignore-pattern \"src/main/js/libs/**\" --format ./node_modules/eslint-formatter-warning-summary/eslint-formatter-warning-summary.js src/main/js src/test/js",
    "test": "echo \"unit tests: the 17 Karma specs migrate to Vitest in group 9 (D12). Until then run: npm run test:karma against a Grunt tree.\" && exit 0",
    "test:unit": "vitest run",
    "test:karma": "grunt karma:build",
    "test:e2e": "npm --prefix ../../e2e run test:xui --",
    "predeps": "npm run clean:deps -s",
    "deps": "ncu -u && mvn clean install",
    "postdeps": "npm shrinkwrap --dev"
  },
  "dependencies": {
    "backbone": "1.1.2",
    "backbone-relational": "0.9.0",
    "backbone.paginator": "2.0.2",
    "backgrid": "0.3.5",
    "backgrid-filter": "0.3.7",
    "backgrid-select-all": "0.3.5",
    "bootstrap": "3.3.5",
    "bootstrap3-dialog": "1.35.1",
    "classnames": "2.2.5",
    "clockpicker": "0.0.7",
    "codemirror": "4.10.0",
    "eonasdan-bootstrap-datetimepicker": "4.14.30",
    "font-awesome": "4.5.0",
    "handlebars": "4.7.7",
    "i18next": "1.7.3",
    "jquery": "3.7.1",
    "jquery-sortable": "0.9.13",
    "microplugin": "0.0.3",
    "moment": "2.28.0",
    "qrcode-generator": "1.4.4",
    "react": "15.2.1",
    "react-bootstrap": "0.30.1",
    "react-dom": "15.2.1",
    "react-input-autosize": "1.1.0",
    "react-select": "1.0.0-rc.2",
    "redux": "3.5.2",
    "requirejs-text": "2.0.15",
    "selectize": "0.12.1",
    "sifter": "0.4.1",
    "spin.js": "2.0.1",
    "titatoggle": "1.2.14",
    "xdate": "0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "7.27.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.16.0",
    "chai": "3.5.0",
    "cross-env": "3.1.3",
    "eslint-config-forgerock": "file:../node_packages/eslint-config-forgerock-2.0.1.tgz",
    "eslint-formatter-warning-summary": "1.0.1",
    "grunt": "1.6.2",
    "grunt-babel": "8.0.0",
    "grunt-cli": "1.4.3",
    "grunt-contrib-copy": "1.0.0",
    "grunt-contrib-less": "3.0.0",
    "grunt-contrib-requirejs": "1.0.0",
    "grunt-contrib-watch": "1.1.0",
    "grunt-eslint": "19.0.0",
    "grunt-karma": "4.0.2",
    "grunt-newer": "1.3.0",
    "grunt-sync": "0.8.2",
    "grunt-text-replace": "0.4.0",
    "js-yaml": "^4.3.0",
    "jsdoc": "^4.0.3",
    "karma": "6.4.3",
    "karma-babel-preprocessor": "8.0.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-mocha": "2.0.1",
    "karma-requirejs": "1.1.0",
    "less": "^4.2.2",
    "less-plugin-clean-css": "1.5.1",
    "lodash": "4.18.1",
    "minimatch": "^3.1.5",
    "mocha": "7.2.0",
    "requirejs": "2.3.7",
    "rimraf": "2.5.4",
    "sinon": "1.17.6",
    "sinon-chai": "2.8.0",
    "squirejs": "0.2.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "minimatch": "^3.1.5",
    "mocha": {
      "flat": "5.0.2",
      "js-yaml": "$js-yaml"
    },
    "eslint": {
      "shelljs": "^0.8.5",
      "ajv": "$ajv",
      "js-yaml": "$js-yaml"
    },
    "grunt": {
      "js-yaml": "$js-yaml"
    },
    "sifter": {
      "microtime": "3.1.1",
      "node-csv": "0.1.2"
    }
  }
}
